# Pre-baked Kali Dockerfile for AntiGravity Platform
FROM kalilinux/kali-rolling:latest

ENV DEBIAN_FRONTEND=noninteractive

# Update and install all essential security audit tools
RUN apt-get update && apt-get install -y --no-install-recommends \
    nmap \
    masscan \
    amass \
    subfinder \
    dnsenum \
    dnsrecon \
    dnsutils \
    whois \
    gobuster \
    feroxbuster \
    dirb \
    dirsearch \
    ffuf \
    nikto \
    nuclei \
    wpscan \
    whatweb \
    wafw00f \
    httpx-toolkit \
    katana \
    arjun \
    sslscan \
    sslyze \
    testssl.sh \
    enum4linux \
    enum4linux-ng \
    hydra \
    commix \
    curl \
    wget \
    jq \
    ca-certificates \
    libgobject-2.0-0 \
    libcairo2 \
    libpango-1.0-0 \
    libpangocairo-1.0-0 \
    libgdk-pixbuf2.0-0 \
    shared-mime-info \
    python3-playwright \
    && rm -rf /var/lib/apt/lists/*

CMD ["bash"]
