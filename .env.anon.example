# Copy to .env — never commit filled version.
#
# ProtonVPN Free  ─ https://account.protonvpn.com/downloads → WireGuard tab
# Free tier gives NL / JP / US endpoints. Pick one, download the .conf,
# copy the fields out.
PROTON_WG_PRIVATE_KEY=YOUR_PROTON_WG_PRIVATE_KEY_HERE
PROTON_WG_ADDRESS=10.2.0.2/32

# Windscribe Free ─ https://windscribe.com/getconfig/wireguard
# 10 GB/mo. Use a SimpleLogin alias when registering. Copy the peer public
# key and endpoint from the .conf they generate.
WINDSCRIBE_WG_PRIVATE_KEY=YOUR_WINDSCRIBE_WG_PRIVATE_KEY
WINDSCRIBE_WG_ADDRESS=10.66.66.2/32
WINDSCRIBE_WG_PEER_KEY=SERVERS_PUBLIC_KEY_FROM_CONF
WINDSCRIBE_WG_ENDPOINT_IP=X.X.X.X
WINDSCRIBE_WG_ENDPOINT_PORT=443

# Fill this with your ACTUAL public IP (from `curl ifconfig.me` on the
# host BEFORE any VPN is up). The kill switch refuses to start the agent
# if the exit IP equals this value — proves the chain is up.
REAL_WAN_IP=203.0.113.42

# Agent LLM keys — will now leave from Tor exit. Some providers block Tor;
# have a backup.
DEEPSEEK_API_KEY=
EMBEDDING_API_URL=
EMBEDDING_API_KEY=

# Encryption keys — generate: python scripts/generate_keys.py
ENCRYPTION_KEY=CHANGE_ME_RUN_generate_keys
ENCRYPTION_KEY_CURRENT=CHANGE_ME_RUN_generate_keys
