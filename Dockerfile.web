# ============================================================
# AntiGravity Web — API server + built frontend
# ============================================================

# Stage 1: Build the React frontend (pinned node major.minor).
# Use bookworm-slim (glibc) not Alpine — Vite 5+ / rolldown ships prebuilt
# native bindings for linux-x64-gnu but the musl variant is often missing,
# breaking builds inside Alpine.
FROM node:22.11.0-bookworm-slim AS frontend

WORKDIR /app
COPY ui/web/package.json ui/web/package-lock.json* ./
# Known npm bug (https://github.com/npm/cli/issues/4828): `npm ci` against a
# lockfile generated on a different OS/arch omits platform-specific optional
# deps (e.g. @rolldown/binding-linux-x64-gnu), then the build blows up
# looking for the native binary. Force a fresh install that pulls ALL
# optional deps for the current platform.
RUN rm -f package-lock.json \
    && npm install --include=optional --no-audit --no-fund
COPY ui/web/ ./
RUN npm run build

# Stage 2: Python API server (pinned python patch version)
FROM python:3.13.1-slim-bookworm

ENV PYTHONUNBUFFERED=1 \
    PIP_DISABLE_PIP_VERSION_CHECK=1

WORKDIR /app

# System deps for psycopg2, weasyprint, and (optionally) Docker CLI.
#
# Docker CLI is included ONLY when ANTIGRAVITY_WITH_DOCKER_CLI=1 at build
# time. When absent, the API container CANNOT talk to the host Docker socket
# — closing a nasty container-escape path. Deployments that need Kali
# subprocess execution should run the Kali container as a separate service
# and reach it over the network instead of via docker.sock.
ARG ANTIGRAVITY_WITH_DOCKER_CLI=0
RUN apt-get update && apt-get install -y --no-install-recommends \
    libpq-dev gcc curl ca-certificates \
    libglib2.0-0 libcairo2 libpango-1.0-0 libpangocairo-1.0-0 \
    libgdk-pixbuf-2.0-0 libffi-dev shared-mime-info libfreetype6-dev \
    libjpeg-dev zlib1g-dev \
    && if [ "$ANTIGRAVITY_WITH_DOCKER_CLI" = "1" ]; then \
        install -m 0755 -d /etc/apt/keyrings \
        && curl -fsSL https://download.docker.com/linux/debian/gpg -o /etc/apt/keyrings/docker.asc \
        && chmod a+r /etc/apt/keyrings/docker.asc \
        && echo "deb [arch=$(dpkg --print-architecture) signed-by=/etc/apt/keyrings/docker.asc] https://download.docker.com/linux/debian bookworm stable" > /etc/apt/sources.list.d/docker.list \
        && apt-get update && apt-get install -y --no-install-recommends docker-ce-cli ; \
    fi \
    && rm -rf /var/lib/apt/lists/*

# Python deps
COPY requirements.txt ./
COPY ui/api/requirements.txt ./requirements-api.txt
RUN pip install --no-cache-dir -r requirements.txt -r requirements-api.txt psutil slowapi

# Copy source. `.dockerignore` MUST exclude:
#   .env, .env.*, .antigravity/, .audit_logs/, data/db/, reports/, logs/,
#   loot/, node_modules/, .git/, .venv/, tests/, __pycache__/
# so we don't accidentally ship secrets or scan artefacts into the image.
COPY . .

# Copy built frontend
COPY --from=frontend /app/dist /app/ui/web/dist

# Create required dirs
RUN mkdir -p reports data/db loot .audit_logs .antigravity

# ── Drop root ────────────────────────────────────────────────
# Create an unprivileged runtime user and hand it the working tree. The API
# has no reason to run as root; combined with the docker-CLI opt-in above,
# this closes the root-in-container + docker.sock = host escape combo.
RUN useradd --create-home --shell /bin/bash --uid 10001 app \
    && chown -R app:app /app
USER app

# Healthcheck: exercise the health endpoint every 30s.
HEALTHCHECK --interval=30s --timeout=5s --retries=3 \
    CMD curl -fsS "http://127.0.0.1:${API_PORT:-8900}/api/health" || exit 1

EXPOSE 8900

# API_PORT / API_HOST honored by ui/api/server.py's __main__ block; the CMD
# below just launches uvicorn directly (compose sets API_PORT=8900 for parity).
CMD ["sh", "-c", "uvicorn ui.api.server:app --host ${API_HOST:-0.0.0.0} --port ${API_PORT:-8900}"]
