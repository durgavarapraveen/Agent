# ─────────────────────────────────────────────────────────────
# Autonomous Pentesting Agent — sample environment
# Copy to `.env` and fill in the values you need. Anything left
# blank uses the code-level default (usually a safe/no-op path).
# `.env` is git-ignored (see .gitignore).
# ─────────────────────────────────────────────────────────────

# ── LLM providers ────────────────────────────────────────────
# LLM_PROVIDER controls which provider the harness picks first
# (falls through to the next configured provider on failure).
# Values: deepseek | groq | ollama
LLM_PROVIDER=deepseek
LLM_REQUEST_TIMEOUT_SECONDS=60
LLM_MAX_BUDGET_USD=5

# DeepSeek (primary)
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_SMALL_MODEL=deepseek-chat
DEEPSEEK_LARGE_MODEL=deepseek-reasoner

# Groq (fallback)
GROQ_API_KEY=
GROQ_BASE_URL=https://api.groq.com/openai/v1
GROQ_SMALL_MODEL=llama-3.1-8b-instant
GROQ_LARGE_MODEL=llama-3.3-70b-versatile

# Ollama (local)
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_SMALL_MODEL=llama3.1
OLLAMA_LARGE_MODEL=llama3.1
# ── Ollama performance tuning (Phase 10.3); run scripts/setup_local_models.py ──
OLLAMA_NUM_PARALLEL=4
OLLAMA_MAX_LOADED_MODELS=2
OLLAMA_KEEP_ALIVE=30m

# ── Amazon Bedrock (Phase 9.1) — set LLM_PROVIDER=bedrock to use ──
# Auth: IAM role (ECS/EC2) is automatic; for local dev set the standard
# AWS_ACCESS_KEY_ID / AWS_SECRET_ACCESS_KEY env vars.
AWS_REGION=us-east-1
AWS_BEDROCK_SMALL_MODEL=us.anthropic.claude-haiku-4-5-v1
AWS_BEDROCK_LARGE_MODEL=us.anthropic.claude-sonnet-4-v1

# ── Multi-provider routing (Phases 9.2 / 9.3) ──
# Ordered fallback chain — if one provider is down, the next is tried.
LLM_FALLBACK_CHAIN=deepseek,bedrock,ollama
# Hybrid routing: cheap local model for SMALL tasks, cloud for LARGE.
LLM_SMALL_PROVIDER=ollama
LLM_LARGE_PROVIDER=bedrock
LLM_CLOUD_FALLBACK=deepseek

# Embeddings (optional — leave unset to use local hash embedding)
EMBEDDING_API_URL=
EMBEDDING_API_KEY=
EMBEDDING_MODEL=text-embedding-3-small

# ── Threat intel / OSINT (optional) ──────────────────────────
CENSYS_PAT=
SHODAN_API_KEY=
VIRUSTOTAL_API_KEY=
ABUSEIPDB_API_KEY=
NVD_API_KEY=
GITHUB_TOKEN=

# ── Runtime toggles ──────────────────────────────────────────
EXECUTION_MODE=agentic
FALLBACK_ON_ERROR=true
FREE_TIER_MODE=false
OSINT_ENABLE=true

# ── Data retention ───────────────────────────────────────────
RETAIN_PII_DAYS=30
RETAIN_SCANS_DAYS=90

# ── Storage paths ────────────────────────────────────────────
# All scan/finding data is stored in Postgres (see core/database/pg_store.py).
# reports/ file output (HTML, PDF, SARIF, PoC scripts, screenshots) is OFF
# by default — set REPORTS_ENABLED=1 if you want disk artefacts.
REPORTS_ENABLED=0
REPORTS_DIR=reports
# When a scan finishes, wipe its scratch files: /tmp/*.png (screenshots),
# /tmp/spray_* (credential-spray probes), sqlmap/nuclei per-run sessions in
# the Kali container, plus host-side ag_screenshot_* / detonate_* tempdirs
# and per-scan loot/<scan_id>/ subdirectories. Set to 0 to keep everything
# (debugging).
SCAN_CLEANUP_ENABLED=1
# NOTE: KNOWLEDGE_DB_PATH and TOOL_HEALTH_DB_PATH are legacy — the canonical
# knowledge / tool-health data now lives in Postgres via
# `core.database.pg_store`. These variables are ONLY read as fallbacks in
# code paths flagged for removal. Leave them unset unless you're running the
# legacy standalone tools.
KNOWLEDGE_DB_PATH=
TOOL_HEALTH_DB_PATH=
AUDIT_LOG_PATH=.audit_logs/audit.jsonl

# ── Encryption keys (rotated) ────────────────────────────────
# Generate: python scripts/generate_keys.py
ENCRYPTION_KEY=CHANGE_ME_RUN_generate_keys
ENCRYPTION_KEY_CURRENT=CHANGE_ME_RUN_generate_keys
ENCRYPTION_KEY_PREVIOUS=

# ── Docker / API ─────────────────────────────────────────────
DOCKER_CONTAINER=kali-pentesting
DOCKER_TIMEOUT=1200
API_HOST=0.0.0.0
API_PORT=8903
KALI_CONTAINER=kali-pentesting

# ANTIGRAVITY_ENV — `production` refuses to boot without API_KEY and an
# explicit CORS allowlist. `development` (default) auto-generates a per-machine
# dev API key and a dev encryption key, and defaults CORS to localhost origins.
ANTIGRAVITY_ENV=development

# CORS_ORIGINS: comma-separated. `*` is REJECTED in production. In dev, leave
# blank to get a sane localhost allowlist. In production set a concrete list:
# CORS_ORIGINS=https://ui.example.com,https://admin.example.com
CORS_ORIGINS=

# API_KEY: required in production. Header-only (X-API-Key). Query-string keys
# are accepted only for download endpoints since browsers can't set headers on
# top-level navigations. Leave blank in dev — a random key is auto-generated
# at `.antigravity/dev_api_key` and printed at startup.
API_KEY=

# THREAT_INTEL_INSECURE_TLS — `1` disables TLS verification on third-party
# threat feeds (only useful behind a corporate MITM proxy). Default: verify.
THREAT_INTEL_INSECURE_TLS=

# RAG_INGEST_ROOTS — semicolon-separated allowlist of directories that may be
# ingested via `POST /api/rag/ingest/file?file_path=...`. Default:
# `data/rag_ingest` under the repo. Any path outside these roots is rejected.
RAG_INGEST_ROOTS=

# FP_MODEL_MIN_ROWS — minimum labelled training rows before the ML false-
# positive filter is enabled. Below this threshold the ML layer is disabled and
# the deterministic signature filter still runs. Provide a labelled
# `training_data.csv` (see core/reporting/fp_filter.py) to feed it. Default: 200.
FP_MODEL_MIN_ROWS=200

# ENCRYPTION_KEY_DEV_UNSAFE — set to `1` in dev only to auto-generate a
# per-machine encryption key at `.antigravity/dev_encryption_key`. Refused in
# production.
ENCRYPTION_KEY_DEV_UNSAFE=

# ── Observability ────────────────────────────────────────────────────
# LOG_LEVEL — DEBUG / INFO / WARNING / ERROR. Structured JSON logging with
# global PII redaction is always on; the level knob controls verbosity.
LOG_LEVEL=INFO
# ANTIGRAVITY_LOG_FORMAT — `json` or `text`. Defaults to `json` on non-TTY
# stdout (containers) and `text` on a TTY (interactive debugging).
ANTIGRAVITY_LOG_FORMAT=
# OpenTelemetry — set OTEL_EXPORTER_OTLP_ENDPOINT to enable tracing.
OTEL_SERVICE_NAME=antigravity
OTEL_EXPORTER_OTLP_ENDPOINT=

# ── Notifications (all optional) ─────────────────────────────────────
# Slack incoming webhook — INFO-level scan completions + finding alerts
SLACK_WEBHOOK_URL=
# PagerDuty Events API v2 routing key — CRITICAL/HIGH findings + platform errors
PAGERDUTY_ROUTING_KEY=
# Generic SIEM HTTP receiver (Splunk HEC / Elastic / other)
SIEM_HTTP_URL=
SIEM_HTTP_TOKEN=
# Catchall webhook — receives every notify.* event as-is
NOTIFIER_GENERIC_WEBHOOK=

# ── LLM circuit breaker (optional) ───────────────────────────────────
# Configure per-provider/model/phase failure isolation.
LLM_BREAKER_STREAK=3
LLM_BREAKER_WINDOW_S=120
LLM_BREAKER_COOLDOWN_S=60

# ── HTTP tool TLS verification ───────────────────────────────────────
# Set to `1` when using AntiGravity for OSINT/clean-target lookups. Leave
# blank for pentesting against self-signed targets.
HTTP_TOOL_VERIFY_TLS=
HTTP_ACTUATOR_VERIFY_TLS=

# ── KnowledgeStore deprecation ───────────────────────────────────────
# Set to `1` to promote the KB_STRICT_DEPRECATION warning into a RuntimeError
# so new callers of the deprecated `kb_*` schema fail their tests instead of
# silently drifting.
KB_STRICT_DEPRECATION=

# ── Postgres ─────────────────────────────────────────────────
# POSTGRES_* are the canonical names. DB_HOST / DB_PORT / DB_NAME / DB_USER /
# DB_PASSWORD are accepted as legacy aliases and take precedence when set.
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_DB=pentesting_db
POSTGRES_USER=pentesting_user
# REQUIRED — generate with:
#   python -c "import secrets; print(secrets.token_urlsafe(24))"
# Never ship a default password. The previous default (`pentesting_password`)
# was copy-pasted into deploys and shipped to production more than once.
POSTGRES_PASSWORD=
DATABASE_URL=
