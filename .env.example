# Autonomous Pentesting Agent — sample environment.
# Copy to `.env` and fill what you need; blanks use safe code defaults.
# `.env` is git-ignored.

# ── LLM providers ────────────────────────────────────────────
# Primary provider; falls through LLM_FALLBACK_CHAIN on failure.
# Values: bedrock | deepseek | ollama
LLM_PROVIDER=bedrock
LLM_MAX_BUDGET_USD=5

# DeepSeek (default)
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_SMALL_MODEL=deepseek-chat
DEEPSEEK_LARGE_MODEL=deepseek-reasoner

# Amazon Bedrock — set LLM_PROVIDER=bedrock. Auth: IAM role (ECS/EC2) auto;
# for local dev use AWS_ACCESS_KEY_ID / AWS_SECRET_ACCESS_KEY.
AWS_REGION=us-east-1
AWS_BEDROCK_SMALL_MODEL=us.anthropic.claude-haiku-4-5-v1
AWS_BEDROCK_LARGE_MODEL=us.anthropic.claude-sonnet-4-v1

# Ollama (local)
OLLAMA_BASE_URL=http://localhost:11434

# Multi-provider routing
LLM_FALLBACK_CHAIN=deepseek,bedrock,ollama
LLM_SMALL_PROVIDER=ollama
LLM_LARGE_PROVIDER=bedrock
LLM_CLOUD_FALLBACK=deepseek

# LLM circuit breaker (per provider/model/phase failure isolation)
LLM_BREAKER_STREAK=3
LLM_BREAKER_WINDOW_S=120
LLM_BREAKER_COOLDOWN_S=60

# Embeddings (optional — blank = local hash embedding)
EMBEDDING_API_URL=
EMBEDDING_API_KEY=
EMBEDDING_MODEL=text-embedding-3-small

# ── Threat intel / OSINT (all optional) ──────────────────────
CENSYS_PAT=
SHODAN_API_KEY=
VIRUSTOTAL_API_KEY=
ABUSEIPDB_API_KEY=
NVD_API_KEY=
GITHUB_TOKEN=
# 1 = skip TLS verify on threat feeds (corporate MITM proxy only)
THREAT_INTEL_INSECURE_TLS=

# ── Neo toggles ──────────────────────────────────────────────
OSINT_ENABLE=true
FREE_TIER_MODE=false
# Metasploit read-only aux lane (msf_scanner)
NEO_ENABLE_MSF=0
# Also mirror the hash-chained audit to data/*.log (default: DB only)
NEO_FILE_AUDIT=0
# Post-scan ASM baseline + regression (writes data/{baselines,regression,asm})
NEO_ASM_MONITORING=0
# Opt-in git sync of the payload catalog (data/payloads)
NEO_PAYLOAD_SYNC=0
# Probe fan-out concurrency (health-capped) and watchdog soft-exit fraction
PROBE_CONCURRENCY=8
BUDGET_SOFT_EXIT_FRAC=0.85
# Jev typed-classifier gate sites (all optional)
NEO_JEV_ROUTING=0
NEO_JEV_PHASE_GATE=0
NEO_JEV_TOOL_GATE=0
NEO_JEV_PRIORITIZE=1

# ── Data retention ───────────────────────────────────────────
RETAIN_PII_DAYS=30
RETAIN_SCANS_DAYS=90

# ── Reports / cleanup ────────────────────────────────────────
# All findings live in Postgres. reports/ file output is OFF by default.
REPORTS_ENABLED=0
REPORTS_DIR=reports
# Wipe per-scan scratch files when a scan finishes (0 = keep for debugging)
SCAN_CLEANUP_ENABLED=1

# ── Encryption ───────────────────────────────────────────────
# Generate: python scripts/generate_keys.py
ENCRYPTION_KEY=CHANGE_ME_RUN_generate_keys
ENCRYPTION_KEY_CURRENT=CHANGE_ME_RUN_generate_keys
# Dev-only: 1 auto-generates a per-machine key (refused in production)
ENCRYPTION_KEY_DEV_UNSAFE=

# ── Docker / API ─────────────────────────────────────────────
KALI_CONTAINER=kali-pentesting
DOCKER_CONTAINER=kali-pentesting
API_HOST=0.0.0.0
API_PORT=8903
# production refuses to boot without API_KEY + explicit CORS allowlist;
# development (default) auto-generates a dev key + localhost CORS.
ANTIGRAVITY_ENV=development
# comma-separated; `*` rejected in production; blank = localhost in dev
CORS_ORIGINS=
# required in production; blank in dev (auto key at .antigravity/dev_api_key)
API_KEY=
# HTTP tool TLS verify: 1 for clean-target/OSINT, blank for self-signed targets
HTTP_TOOL_VERIFY_TLS=
HTTP_ACTUATOR_VERIFY_TLS=

# ── RAG / ML ─────────────────────────────────────────────────
# semicolon-separated ingest allowlist (default: data/rag_ingest)
RAG_INGEST_ROOTS=
# min labelled rows before the ML false-positive filter turns on
FP_MODEL_MIN_ROWS=200

# ── Observability ────────────────────────────────────────────
LOG_LEVEL=INFO
# json | text (default: json on non-TTY, text on TTY)
ANTIGRAVITY_LOG_FORMAT=
OTEL_SERVICE_NAME=antigravity
# set to enable OpenTelemetry tracing
OTEL_EXPORTER_OTLP_ENDPOINT=

# ── Notifications (all optional) ─────────────────────────────
SLACK_WEBHOOK_URL=
PAGERDUTY_ROUTING_KEY=
SIEM_HTTP_URL=
SIEM_HTTP_TOKEN=
NOTIFIER_GENERIC_WEBHOOK=

# ── Postgres ─────────────────────────────────────────────────
# POSTGRES_* are canonical; DB_* are accepted legacy aliases.
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_DB=pentesting_db
POSTGRES_USER=pentesting_user
# Generate: python -c "import secrets; print(secrets.token_urlsafe(24))"
POSTGRES_PASSWORD=
DATABASE_URL=

# ── Anonymized egress (optional) — docker-compose.anon.yml only ──
# ProtonVPN Free: account.protonvpn.com/downloads (WireGuard tab)
PROTON_WG_PRIVATE_KEY=YOUR_PROTON_WG_PRIVATE_KEY_HERE
PROTON_WG_ADDRESS=10.2.0.2/32
# Windscribe Free: windscribe.com/getconfig/wireguard
WINDSCRIBE_WG_PRIVATE_KEY=YOUR_WINDSCRIBE_WG_PRIVATE_KEY
WINDSCRIBE_WG_ADDRESS=10.66.66.2/32
WINDSCRIBE_WG_PEER_KEY=SERVERS_PUBLIC_KEY_FROM_CONF
WINDSCRIBE_WG_ENDPOINT_IP=X.X.X.X
WINDSCRIBE_WG_ENDPOINT_PORT=443
# Your real public IP (curl ifconfig.me before any VPN). Kill switch aborts
# if the exit IP equals this — proves the chain is up.
REAL_WAN_IP=203.0.113.42
