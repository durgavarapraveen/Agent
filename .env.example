# ═══════════════════════════════════════════════════════════════
# LLM Provider
# ═══════════════════════════════════════════════════════════════
LLM_PROVIDER=groq
GROQ_API_KEY=gsk_your_key_here
GROQ_MODEL=qwen/qwen3.6-27b

# Alternative: Claude Haiku (recommended for production)
# LLM_PROVIDER=claude
# CLAUDE_API_KEY=sk-ant-your_key_here
# CLAUDE_MODEL=claude-3-5-haiku-20241022

# Alternative: Ollama (free, local)
# LLM_PROVIDER=ollama
# OLLAMA_BASE_URL=http://localhost:11434
# OLLAMA_SMALL_MODEL=qwen3:8b
# OLLAMA_LARGE_MODEL=qwen3:8b

# ═══════════════════════════════════════════════════════════════
# Intelligence APIs (Phase 1 - all FREE)
# ═══════════════════════════════════════════════════════════════

# GitHub token (optional, increases rate limit from 10 to 30 req/min)
# Get one at: https://github.com/settings/tokens (no scopes needed)
GITHUB_TOKEN=

# Shodan API key (optional, free tier: unlimited host lookups)
# Get one at: https://account.shodan.io/
SHODAN_API_KEY=

# NVD API key (optional, increases rate limit from 5 to 50 req/30s)
# Get one at: https://nvd.nist.gov/developers/request-an-api-key
# NVD_API_KEY=

# Knowledge base location
KNOWLEDGE_DB=knowledge_base.db

# ═══════════════════════════════════════════════════════════════
# Docker
# ═══════════════════════════════════════════════════════════════
DOCKER_CONTAINER=kali-pentesting
DOCKER_TIMEOUT=120
