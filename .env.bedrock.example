# ── Bedrock LLM — SAME model in dev and production ────────────────────────
# Set these THREE identically in dev and prod so the LLM never drifts.
# Read via core/llm/bedrock_config.py (single source of truth).
AWS_REGION=us-east-1
AWS_BEDROCK_SMALL_MODEL=us.anthropic.claude-haiku-4-5-20251001-v1:0
AWS_BEDROCK_LARGE_MODEL=us.anthropic.claude-sonnet-4-20250514-v1:0

# Optional LLM spend cap (watchdog also enforces budgets)
LLM_MAX_BUDGET_USD=100.0

# ── Credentials: the ONLY thing that differs between dev and prod ─────────
# DEV (local): supply keys, or use `aws configure` / AWS_PROFILE. boto3 picks these up.
#   AWS_ACCESS_KEY_ID=...
#   AWS_SECRET_ACCESS_KEY=...
#   AWS_SESSION_TOKEN=...        # if using temporary creds
#
# PROD (AWS): DO NOT set keys. Attach an IAM role to the EC2 instance / ECS task /
# EKS pod (IRSA) with bedrock:InvokeModel on the two model ARNs above. boto3's
# default provider chain resolves the role automatically — same code path as dev.
#
# The agent treats Bedrock as available only when creds AND region resolve
# (core/orchestration/execution_mode.is_bedrock_available); otherwise it runs
# deterministic-only and logs a fallback-streak warning — it never silently
# substitutes heuristics for real LLM output.
